public void init()
{
    super();

    ABSExcessObsolete_ds.query().dataSourceNo(1).sortClear();
    ABSExcessObsolete_ds.query().dataSourceNo(1).addSortField(
        fieldNum(ABSExcessObsolete, ProvisionValue), SortOrder::Descending);

    element.refreshChartData();
    ABSEOChartData_ds.research();

    if (EOChart)
    {
        EOChart.update();
    }
}
]]></Source>
			</Method>
			<Method>
				<Name>refreshChartData</Name>
				<Source><![CDATA[
/// Rebuilds the in-memory aging-bucket aggregate that backs the stacked column chart:
/// provision value + remaining (uncovered) on-hand value per bucket. <= 5 rows.
public void refreshChartData()
{
    ABSExcessObsolete   eo;
    ABSEOAgingBucket    bucketLoop;
    container           buckets = [
        ABSEOAgingBucket::NoHistory,
        ABSEOAgingBucket::Active,
        ABSEOAgingBucket::Slow,
        ABSEOAgingBucket::VerySlow,
        ABSEOAgingBucket::Dormant,
        ABSEOAgingBucket::Dead];
    int                 i;

    delete_from ABSEOChartData;

    for (i = 1; i <= conLen(buckets); i++)
    {
        bucketLoop = conPeek(buckets, i);

        select sum(OnHandValue), sum(ProvisionValue) from eo
            where eo.AgingBucket == bucketLoop;

        if (eo.OnHandValue == 0 && eo.ProvisionValue == 0)
        {
            continue;
        }

        ABSEOChartData.clear();
        ABSEOChartData.BucketName     = SysDictEnum::newName(enumStr(ABSEOAgingBucket)).value2Label(enum2int(bucketLoop));
        ABSEOChartData.ProvisionValue = eo.ProvisionValue;
        ABSEOChartData.RemainingValue = max(0, eo.OnHandValue - eo.ProvisionValue);
        ABSEOChartData.insert();
    }
}
]]></Source>
			</Method>
