				<Methods>
					<Method>
						<Name>displayOption</Name>
						<Source><![CDATA[
    public void displayOption(Common _record, FormRowDisplayOption _options)
    {
        ABSExcessObsolete eo = _record;
        int bgColor;

        // Only colour when history is meaningful or the bucket is already serious,
        // so statistically thin items don't all scream (Pareto P5 lesson).
        if (eo.HistoryMonthsAvailable < 3 && eo.AgingBucket < ABSEOAgingBucket::Dormant)
        {
            super(_record, _options);
            return;
        }

        switch (eo.AgingBucket)
        {
            case ABSEOAgingBucket::Dead:      bgColor = ABSUIColors::critical(); break;
            case ABSEOAgingBucket::Dormant:   bgColor = ABSUIColors::warning();  break;
            case ABSEOAgingBucket::VerySlow:  bgColor = ABSUIColors::caution();  break;
            case ABSEOAgingBucket::Slow:      bgColor = ABSUIColors::info();     break;
            case ABSEOAgingBucket::NoHistory: bgColor = ABSUIColors::neutral();  break;
            default:
                super(_record, _options);
                return;
        }

        _options.backColor(bgColor);
        super(_record, _options);
    }
]]></Source>
