public void init()
{
    super();

    element.buildExceptionSeries(ABSExceptionTypeChartData);
    ABSExceptionTypeChartData_ds.research();

    element.buildEOSeries(ABSEOChartData);
    ABSEOChartData_ds.research();

    if (SegmentValueChart)
    {
        SegmentValueChart.update();
    }
    if (ExceptionTypeChart)
    {
        ExceptionTypeChart.update();
    }
    if (EOProvisionChart)
    {
        EOProvisionChart.update();
    }
}
]]></Source>
			</Method>
			<Method>
				<Name>buildEOSeries</Name>
				<Source><![CDATA[
    /// Aggregates the Excess & Obsolete cockpit rows into provision vs remaining value
    /// per aging bucket, so the workspace shows write-down exposure at a glance without
    /// the planner opening the cockpit. Mirrors ABSExcessObsolete.refreshChartData().
    public void buildEOSeries(ABSEOChartData _cursor)
    {
        ABSExcessObsolete   eo;
        ABSEOAgingBucket    bucketLoop;
        container           buckets = [
            ABSEOAgingBucket::NoHistory,
            ABSEOAgingBucket::Active,
            ABSEOAgingBucket::Slow,
            ABSEOAgingBucket::VerySlow,
            ABSEOAgingBucket::Dormant,
            ABSEOAgingBucket::Dead];
        int                 i;

        delete_from _cursor;

        for (i = 1; i <= conLen(buckets); i++)
        {
            bucketLoop = conPeek(buckets, i);

            select sum(OnHandValue), sum(ProvisionValue) from eo
                where eo.AgingBucket == bucketLoop;

            if (eo.OnHandValue == 0 && eo.ProvisionValue == 0)
            {
                continue;
            }

            _cursor.clear();
            _cursor.BucketName     = SysDictEnum::newName(enumStr(ABSEOAgingBucket)).value2Label(enum2int(bucketLoop));
            _cursor.ProvisionValue = eo.ProvisionValue;
            _cursor.RemainingValue = max(0, eo.OnHandValue - eo.ProvisionValue);
            _cursor.insert();
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>buildExceptionSeries</Name>
				<Source><![CDATA[
    /// Aggregates OPEN MRP exceptions into a small count-by-type series for the chart,
    /// instead of binding the chart to the full ABSMRPException row set (which would
    /// plot one category per row and render an unreadable axis of zeros).
    public void buildExceptionSeries(ABSExceptionTypeChartData _cursor)
    {
        ABSMRPException exception;

        delete_from _cursor;

        while select count(RecId), ExceptionType, TypeName from exception
            group by exception.ExceptionType, exception.TypeName
            where exception.Status == ABSMRPExceptionStatus::Open
        {
            _cursor.clear();
            _cursor.TypeName       = exception.TypeName
                ? exception.TypeName
                : SysDictEnum::newName(enumStr(ABSMRPExceptionType)).value2Label(enum2int(exception.ExceptionType));
            _cursor.ExceptionCount = any2int(exception.RecId);
            _cursor.insert();
        }
    }
]]></Source>
			</Method>
			<Method>
				<Name>populateCards</Name>
				<Source><![CDATA[
    public void populateCards(ABSWorkspaceCardData _cursor)
    {
        ABSItemABCXYZ           abcXyzAgg;
        ABSItemABCXYZ           abcXyzJoin;
        InventSum               inventSumAgg;
        InventDim               inventDimJoin;
        int                     abcInt;
        int                     xyzInt;

        delete_from _cursor;

        for (abcInt = 1; abcInt <= 3; abcInt++)
        {
            for (xyzInt = 1; xyzInt <= 3; xyzInt++)
            {
                ABSABCClassification abcClass = abcInt;
                ABSXYZClassification xyzClass = xyzInt;

                select count(RecId), sum(SalesAmt12M) from abcXyzAgg
                    where abcXyzAgg.ABCClass == abcClass
                       && abcXyzAgg.XYZClass == xyzClass;

                select sum(PostedValue) from inventSumAgg
                    join inventDimJoin
                        where inventDimJoin.inventDimId == inventSumAgg.inventDimId
                    exists join abcXyzJoin
                        where abcXyzJoin.ItemId   == inventSumAgg.ItemId
                           && abcXyzJoin.SiteId   == inventDimJoin.InventSiteId
                           && abcXyzJoin.ABCClass == abcClass
                           && abcXyzJoin.XYZClass == xyzClass;

                _cursor.ABCClass            = abcClass;
                _cursor.XYZClass            = xyzClass;
                _cursor.SegmentName         = enum2Str(abcClass) + enum2Str(xyzClass);
                _cursor.ItemCount           = any2Int(abcXyzAgg.RecId);
                _cursor.TotalConsumption12M = abcXyzAgg.SalesAmt12M;
                _cursor.TotalInventoryValue = inventSumAgg.PostedValue;
                _cursor.insert();
            }
        }
    }
]]></Source>
