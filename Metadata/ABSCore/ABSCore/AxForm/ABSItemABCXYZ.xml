			<Method>
				<Name>buildParetoSeries</Name>
				<Source><![CDATA[
/// Rebuilds the Pareto percentile series from the grid's CURRENT filter.
/// Ranks items by usage value descending and emits ~100 points
/// (x = % of items, y = cumulative % of usage value), immune to grid sort order.
private void buildParetoSeries(ABSItemABCXYZParetoData _cursor)
{
    ABSItemABCXYZ           src;
    Query                   q;
    QueryRun                qr;
    QueryBuildDataSource    qbds;
    real                    totalValue, running;
    int64                   n, rank;
    int                     pct, lastPct;

    delete_from _cursor;

    // Clone the grid's current query (keeps ABC/XYZ + quick-filter ranges), ranked by value desc.
    q = new Query(ABSItemABCXYZ_ds.queryRun().query());
    qbds = q.dataSourceTable(tableNum(ABSItemABCXYZ));
    qbds.sortClear();
    qbds.addSortField(fieldNum(ABSItemABCXYZ, SalesAmt12M), SortOrder::Descending);

    // Pass 1: total usage value + item count over the filtered set.
    // Only items WITH usage value participate: the completeness sweep classifies
    // every no-history item as C/Z with SalesAmt12M = 0, and there are typically
    // thousands of them. Including them makes n huge so the few value-bearing items
    // all collapse into the first percentile bucket — the curve renders flat at ~100%.
    qr = new QueryRun(q);
    while (qr.next())
    {
        src = qr.get(tableNum(ABSItemABCXYZ));
        if (src.SalesAmt12M <= 0)
            continue;
        totalValue += src.SalesAmt12M;
        n++;
    }

    if (n == 0 || totalValue <= 0)
        return;

    // Pass 2: accumulate, emit one point per integer percentile of items (~100 points).
    qr = new QueryRun(q);
    lastPct = 0;
    rank = 0;
    while (qr.next())
    {
        src = qr.get(tableNum(ABSItemABCXYZ));
        if (src.SalesAmt12M <= 0)
            continue;
        rank++;
        running += src.SalesAmt12M;
        pct = int642int((rank * 100) div n);
        if (pct != lastPct)
        {
            _cursor.clear();
            _cursor.ItemPct            = pct;
            // Zero-padded string category: SysChart auto-sorts a numeric category
            // field descending (axis rendered 97..1). A string category is plotted
            // in data-source order; zero-padding to 3 digits keeps it ascending under
            // any lexical sort, so the x-axis reads 001..100 left-to-right.
            _cursor.ItemPctLabel       = substr('000', 1, 3 - strLen(int2str(pct))) + int2str(pct);
            _cursor.CumulativeValuePct = (running / totalValue) * 100;
            _cursor.Ref80              = 80;
            _cursor.Ref95              = 95;
            _cursor.insert();
            lastPct = pct;
        }
    }
}
]]></Source>
