private void applySortByCriticality()
{
	QueryBuildDataSource qbds = ABSItemABCXYZ_ds.query().dataSourceNo(1);

	// Use overstock risk and demand variability as a severity proxy.
	qbds.sortClear();
	qbds.addSortField(fieldNum(ABSItemABCXYZ, RangeOfCoverage), SortOrder::Descending);
	qbds.addSortField(fieldNum(ABSItemABCXYZ, DemandCV), SortOrder::Descending);
	qbds.addSortField(fieldNum(ABSItemABCXYZ, SalesAmt12M), SortOrder::Descending);
}
]]></Source>
