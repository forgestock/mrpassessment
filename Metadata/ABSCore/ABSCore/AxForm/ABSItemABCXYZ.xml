				<Source><![CDATA[
[Form]
public class ABSItemABCXYZ extends FormRun
{
    // Hidden query ranges used by ABC/XYZ filter buttons
    QueryBuildRange qbrABC;
    QueryBuildRange qbrXYZ;
}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
public void init()
{
    QueryBuildDataSource qbds;
    QueryBuildRange existingRange;
    int i;

    super();

    qbds = ABSItemABCXYZ_ds.query().dataSourceNo(1);

	// Default sort: ABC class → XYZ class → sales amount descending
	this.applySortDefault();

    // When navigated from a workspace tile the platform merges the menu item's query
    // into the datasource during super(). Take ownership of those ranges and make them
    // hidden so the ABC/XYZ filter buttons control them consistently.
    for (i = 1; i <= qbds.rangeCount(); i++)
    {
        existingRange = qbds.range(i);
        if (existingRange.field() == fieldNum(ABSItemABCXYZ, ABCClass) && qbrABC == null)
        {
            qbrABC = existingRange;
            qbrABC.status(RangeStatus::Hidden);
        }
        else if (existingRange.field() == fieldNum(ABSItemABCXYZ, XYZClass) && qbrXYZ == null)
        {
            qbrXYZ = existingRange;
            qbrXYZ.status(RangeStatus::Hidden);
        }
    }

    // If not already present (generic navigation), add new hidden ranges
    if (qbrABC == null)
    {
        qbrABC = qbds.addRange(fieldNum(ABSItemABCXYZ, ABCClass));
        qbrABC.status(RangeStatus::Hidden);
    }
    if (qbrXYZ == null)
    {
        qbrXYZ = qbds.addRange(fieldNum(ABSItemABCXYZ, XYZClass));
        qbrXYZ.status(RangeStatus::Hidden);
    }

    if (ParetoChart)
    {
        ParetoChart.update();
    }
}
]]></Source>
