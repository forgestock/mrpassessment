			<DataSource>
				<Name>ABSItemABCXYZParetoData</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
    /// The series is built in percentile order, but an InMemory data source
    /// without an explicit sort returns rows in undefined order, and SysChart
    /// auto-sorts a NUMERIC category descending (axis rendered 97..1). The chart
    /// category is a zero-padded STRING (ItemPctLabel) plotted in data-source order;
    /// sort it ascending so the x-axis reads 001..100 left-to-right.
    public void init()
    {
        super();
        this.query().dataSourceTable(tableNum(ABSItemABCXYZParetoData))
            .addSortField(fieldNum(ABSItemABCXYZParetoData, ItemPctLabel), SortOrder::Ascending);
    }
]]></Source>
