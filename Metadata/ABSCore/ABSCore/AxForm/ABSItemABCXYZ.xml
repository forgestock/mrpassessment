						<Name>displayOption</Name>
						<Source><![CDATA[
    public void displayOption(Common _record, FormRowDisplayOption _options)
    {
        ABSItemABCXYZ     row = _record;
        ABSExcessObsolete eo;

        // K3: colour the row by the Excess & Obsolete aging bucket (single source of
        // truth shared with the E&O cockpit), instead of a local RangeOfCoverage band
        // that could disagree with the cockpit. The cockpit owns the excess-side story;
        // this just surfaces its verdict next to the classification.
        select firstonly AgingBucket from eo
            where eo.ItemId == row.ItemId
               && eo.SiteId == row.SiteId;

        switch (eo.AgingBucket)
        {
            case ABSEOAgingBucket::Dead:     _options.backColor(ABSUIColors::critical()); break;
            case ABSEOAgingBucket::Dormant:  _options.backColor(ABSUIColors::warning());  break;
            case ABSEOAgingBucket::VerySlow: _options.backColor(ABSUIColors::caution());  break;
        }

        super(_record, _options);
    }
]]></Source>
