					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
    public void executeQuery()
    {
        super();
        element.buildParetoSeries(ABSItemABCXYZParetoData);
        ABSItemABCXYZParetoData_ds.research();
        if (ParetoChart)
        {
            ParetoChart.update();
        }
    }
]]></Source>
