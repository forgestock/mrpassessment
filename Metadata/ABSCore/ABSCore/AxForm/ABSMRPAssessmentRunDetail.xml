                <Name>ABSMRPAssessmentResult</Name>
                <Methods>
                    <Method>
                        <Name>displayOption</Name>
                        <Source><![CDATA[
    public void displayOption(Common _record, FormRowDisplayOption _options)
    {
        ABSMRPAssessmentResult result = _record;
        int bgColor;

        switch (result.Severity)
        {
            case ABSMRPAssessmentSeverity::Critical:
                bgColor = ABSUIColors::critical();
                break;
            case ABSMRPAssessmentSeverity::High:
                bgColor = ABSUIColors::warning();
                break;
            case ABSMRPAssessmentSeverity::Medium:
                bgColor = ABSUIColors::caution();
                break;
            case ABSMRPAssessmentSeverity::Low:
                bgColor = ABSUIColors::info();
                break;
            case ABSMRPAssessmentSeverity::NoIssue:
                bgColor = ABSUIColors::healthy();
                break;
            default:
                super(_record, _options);
                return;
        }

        _options.backColor(bgColor);
        super(_record, _options);
    }
]]></Source>
                    </Method>
