						<Name>clicked</Name>
						<Source><![CDATA[
        void clicked()
        {
            MultiSelectionHelper helper = MultiSelectionHelper::construct();
            ABSMRPException      exRec;
            int                 actioned = 0;
            int                 skipped  = 0;

            helper.parmDatasource(ABSMRPException_ds);
            exRec = helper.getFirst();

            if (!exRec || !exRec.RecId)
            {
                warning("@ABS:ABSSelectExceptionToDismiss");
                return;
            }

            // R6: act on every marked row (falls back to the active row when none marked).
            while (exRec && exRec.RecId)
            {
                if (exRec.Status == ABSMRPExceptionStatus::Open)
                {
                    exRec.updateStatus(ABSMRPExceptionStatus::Dismissed);
                    actioned++;
                }
                else
                {
                    skipped++;
                }
                exRec = helper.getNext();
            }

            ABSMRPException_ds.research(true);

            if (actioned)
            {
                info(strFmt("@ABS:ABSExceptionsDismissed", actioned));
            }
            if (skipped)
            {
                warning(strFmt("@ABS:ABSExceptionsSkippedNotOpen", skipped));
            }
        }
    
]]></Source>
