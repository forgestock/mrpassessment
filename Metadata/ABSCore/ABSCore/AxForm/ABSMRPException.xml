			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
public void init()
{
    QueryBuildDataSource qbds;
    QueryBuildRange      qbrStatusFilter;
    QueryBuildRange      qbrSeverityFilter;

    super();

    // Default sort: highest priority first, then most severe.
    ABSMRPException_ds.query().dataSourceNo(1).sortClear();
    ABSMRPException_ds.query().dataSourceNo(1).addSortField(
        fieldNum(ABSMRPException, PriorityScore), SortOrder::Descending);
    ABSMRPException_ds.query().dataSourceNo(1).addSortField(
        fieldNum(ABSMRPException, Severity), SortOrder::Descending);

    // Opened from the workspace "Items needing attention" KPI tile: pre-filter to
    // the exact set the tile counts — open, high-severity exceptions.
    if (element.args()
        && element.args().menuItemName() == menuItemDisplayStr(ABSMRPExceptionAttention))
    {
        qbds = ABSMRPException_ds.query().dataSourceNo(1);

        qbrStatusFilter = qbds.addRange(fieldNum(ABSMRPException, Status));
        qbrStatusFilter.value(queryValue(ABSMRPExceptionStatus::Open));
        qbrStatusFilter.status(RangeStatus::Hidden);

        qbrSeverityFilter = qbds.addRange(fieldNum(ABSMRPException, Severity));
        qbrSeverityFilter.value(queryValue(ABSMRPExceptionSeverity::High));
        qbrSeverityFilter.status(RangeStatus::Hidden);
    }

    element.buildExceptionSeries(ABSExceptionTypeChartData);
    ABSExceptionTypeChartData_ds.research();

    if (ExceptionChart)
    {
        ExceptionChart.update();
    }
}
]]></Source>
			</Method>
			<Method>
				<Name>buildExceptionSeries</Name>
				<Source><![CDATA[
    /// Aggregates OPEN exceptions into a small count-by-type series for the donut,
    /// instead of binding the chart to the full ABSMRPException row set (which would
    /// plot one slice per record and flood the legend).
    public void buildExceptionSeries(ABSExceptionTypeChartData _cursor)
    {
        ABSMRPException exception;

        delete_from _cursor;

        while select count(RecId), ExceptionType, TypeName from exception
            group by exception.ExceptionType, exception.TypeName
            where exception.Status == ABSMRPExceptionStatus::Open
        {
            _cursor.clear();
            _cursor.TypeName       = exception.TypeName
                ? exception.TypeName
                : SysDictEnum::newName(enumStr(ABSMRPExceptionType)).value2Label(enum2int(exception.ExceptionType));
            _cursor.ExceptionCount = any2int(exception.RecId);
            _cursor.insert();
        }
    }
]]></Source>
			</Method>
