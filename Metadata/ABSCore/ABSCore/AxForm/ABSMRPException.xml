						<Name>displayOption</Name>
						<Source><![CDATA[
    public void displayOption(Common _record, FormRowDisplayOption _options)
    {
        ABSMRPException exceptionRec = _record;
        int bgColor;

        switch (exceptionRec.Severity)
        {
            case ABSMRPExceptionSeverity::High:
                bgColor = ABSUIColors::critical();
                break;
            case ABSMRPExceptionSeverity::Medium:
                bgColor = ABSUIColors::caution();
                break;
            case ABSMRPExceptionSeverity::Low:
                bgColor = ABSUIColors::healthy();
                break;
            default:
                super(_record, _options);
                return;
        }

        _options.backColor(bgColor);
        super(_record, _options);
    }
]]></Source>
