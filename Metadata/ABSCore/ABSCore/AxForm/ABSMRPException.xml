        {
            ABSMRPExceptionController::main(new Args());
            ABSMRPException_ds.research(true);
            element.buildExceptionSeries(ABSExceptionTypeChartData);
            ABSExceptionTypeChartData_ds.research();
            if (ExceptionChart)
            {
                ExceptionChart.update();
            }
        }
    
]]></Source>
