			<Control>
				<Name>ViewRequirementBtn</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// R2: one click from the triage decision to the underlying planned order.
        void clicked()
        {
            ABSMRPException exRec = ABSMRPException_ds.cursor();
            ReqPO           reqPO;
            Args            args;
            MenuFunction    mf;

            if (!exRec || !exRec.RecId)
            {
                return;
            }

            // Safety-stock breaches carry no planned order (ReqPORecId == 0).
            if (!exRec.ReqPORecId)
            {
                warning("@ABS:ABSNoRequirementToView");
                return;
            }

            select firstonly reqPO
                where reqPO.RecId == exRec.ReqPORecId;
            if (!reqPO.RecId)
            {
                warning("@ABS:ABSRequirementNotFound");
                return;
            }

            args = new Args();
            args.record(reqPO);
            mf = new MenuFunction(menuItemDisplayStr(ReqPO), MenuItemType::Display);
            mf.run(args);
        }
    
]]></Source>
					</Method>
				</Methods>
