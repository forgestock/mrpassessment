				<Source><![CDATA[
/// W8: headline cue strip — four aggregate KPIs computed directly from the
/// source tables (not from the InMemory card data), so the part is self-contained.
public void init()
{
    InventSum       inventSumAgg;
    InventDim       inventDimJoin;
    ABSItemABCXYZ   abcXyzJoin;
    ABSItemABCXYZ   abcXyzAgg;
    ABSMRPException exception;
    ABSExcessObsolete eo;
    real            totalValue;
    int             classifiedCount;
    real            totalUsage;
    real            usageA;
    real            pctA;
    int             attentionCount;
    real            eoValueAtRisk;
    real            eoPct;
    real            turnover;

    super();

    // Total inventory value across classified items.
    select sum(PostedValue) from inventSumAgg
        join inventDimJoin
            where inventDimJoin.inventDimId == inventSumAgg.inventDimId
        exists join abcXyzJoin
            where abcXyzJoin.ItemId == inventSumAgg.ItemId
               && abcXyzJoin.SiteId == inventDimJoin.InventSiteId;
    totalValue = inventSumAgg.PostedValue;

    // Total classified items.
    select count(RecId) from abcXyzAgg;
    classifiedCount = any2int(abcXyzAgg.RecId);

    // Share of 12-month usage value held by A-class items.
    select sum(SalesAmt12M) from abcXyzAgg;
    totalUsage = abcXyzAgg.SalesAmt12M;

    select sum(SalesAmt12M) from abcXyzAgg
        where abcXyzAgg.ABCClass == ABSABCClassification::A;
    usageA = abcXyzAgg.SalesAmt12M;

    pctA = totalUsage ? (usageA / totalUsage) * 100 : 0;

    // Items needing attention = open, high-severity MRP exceptions.
    select count(RecId) from exception
        where exception.Status   == ABSMRPExceptionStatus::Open
           && exception.Severity == ABSMRPExceptionSeverity::High;
    attentionCount = any2int(exception.RecId);

    // Phase 5: capital tied up in excess/obsolete stock (Dormant + Dead buckets),
    // sourced from the E&O cockpit. The tile drills to ABSExcessObsolete.
    select sum(OnHandValue) from eo
        where eo.AgingBucket == ABSEOAgingBucket::Dormant
           || eo.AgingBucket == ABSEOAgingBucket::Dead;
    eoValueAtRisk = eo.OnHandValue;
    eoPct = totalValue ? (eoValueAtRisk / totalValue) * 100 : 0;

    // Phase 5: inventory turnover = 12-month usage value / on-hand value.
    turnover = totalValue ? totalUsage / totalValue : 0;

    InventValueText.text(num2str(totalValue, 0, 0, 1, 3));
    ClassifiedText.text(int2str(classifiedCount));
    PctAText.text(num2str(pctA, 0, 1, 1, 3) + '%');
    AttentionText.text(int2str(attentionCount));
    EOValueText.text(strFmt('%1 (%2%)', num2str(eoValueAtRisk, 0, 0, 1, 3), num2str(eoPct, 0, 1, 1, 3)));
    TurnoverText.text(num2str(turnover, 0, 1, 1, 3) + 'x');
}
]]></Source>
