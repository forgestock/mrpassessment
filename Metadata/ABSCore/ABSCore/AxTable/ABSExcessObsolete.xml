    <Methods>
      <Method>
        <Name>find</Name>
        <Source><![CDATA[
public static ABSExcessObsolete find(ItemId _itemId, InventSiteId _siteId, boolean _forUpdate = false)
{
    ABSExcessObsolete ret;

    ret.selectForUpdate(_forUpdate);

    select firstonly ret
        where ret.ItemId == _itemId
           && ret.SiteId == _siteId;

    return ret;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>exist</Name>
        <Source><![CDATA[
public static boolean exist(ItemId _itemId, InventSiteId _siteId)
{
    return (select firstonly RecId from ABSExcessObsolete
                where ABSExcessObsolete.ItemId == _itemId
                   && ABSExcessObsolete.SiteId == _siteId).RecId != 0;
}
        ]]></Source>
      </Method>
