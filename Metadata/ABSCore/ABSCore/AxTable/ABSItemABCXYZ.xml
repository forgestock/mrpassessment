    <Methods>
      <Method>
        <Name>find</Name>
        <Source><![CDATA[
public static ABSItemABCXYZ find(ItemId _itemId, InventSiteId _siteId, boolean _forUpdate = false)
{
    ABSItemABCXYZ ret;

    ret.selectForUpdate(_forUpdate);

    select firstonly ret
        where ret.ItemId == _itemId
           && ret.SiteId == _siteId;

    return ret;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>exist</Name>
        <Source><![CDATA[
public static boolean exist(ItemId _itemId, InventSiteId _siteId)
{
    return (select firstonly RecId from ABSItemABCXYZ
                where ABSItemABCXYZ.ItemId == _itemId
                   && ABSItemABCXYZ.SiteId == _siteId).RecId != 0;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>findOrCreate</Name>
        <Source><![CDATA[
public static ABSItemABCXYZ findOrCreate(ItemId _itemId, InventSiteId _siteId)
{
    ABSItemABCXYZ ret = ABSItemABCXYZ::find(_itemId, _siteId, true);

    if (!ret)
    {
        ret.ItemId = _itemId;
        ret.SiteId = _siteId;
        ret.insert();
    }

    return ret;
}
        ]]></Source>
      </Method>
