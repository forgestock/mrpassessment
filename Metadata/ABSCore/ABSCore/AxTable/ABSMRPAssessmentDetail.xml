		<Methods>
			<Method>
				<Name>findByRunCheckItem</Name>
				<Source><![CDATA[
public static ABSMRPAssessmentDetail findByRunCheckItem(
    ABSMRPAssessmentRunId _runId,
    ABSMRPCheckCode       _checkCode,
    ItemId                _itemId,
    InventSiteId          _siteId,
    boolean               _forUpdate = false)
{
    ABSMRPAssessmentDetail ret;

    ret.selectForUpdate(_forUpdate);

    select firstonly ret
        where ret.RunId     == _runId
           && ret.CheckCode == _checkCode
           && ret.ItemId    == _itemId
           && ret.SiteId    == _siteId;

    return ret;
}
        
]]></Source>
