    <Methods>
      <Method>
        <Name>find</Name>
        <Source><![CDATA[
public static ABSMRPAssessmentRun find(ABSMRPAssessmentRunId _runId, boolean _forUpdate = false)
{
    ABSMRPAssessmentRun ret;

    ret.selectForUpdate(_forUpdate);

    select firstonly ret
        where ret.RunId == _runId;

    return ret;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>exist</Name>
        <Source><![CDATA[
public static boolean exist(ABSMRPAssessmentRunId _runId)
{
    return (select firstonly RecId from ABSMRPAssessmentRun
                where ABSMRPAssessmentRun.RunId == _runId).RecId != 0;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>generateRunId</Name>
        <Source><![CDATA[
public static ABSMRPAssessmentRunId generateRunId(ReqPlanId _planId)
{
    utcdatetime now  = DateTimeUtil::utcNow();
    date        d    = DateTimeUtil::date(now);
    int         t    = DateTimeUtil::time(now);
    int         hr   = real2int(t / 3600);
    int         mn   = real2int((t mod 3600) / 60);
    int         sc   = t mod 60;
    str         ts   = int2Str(year(d))
                     + (mthOfYr(d)  < 10 ? '0' : '') + int2Str(mthOfYr(d))
                     + (dayOfMth(d) < 10 ? '0' : '') + int2Str(dayOfMth(d))
                     + (hr          < 10 ? '0' : '') + int2Str(hr)
                     + (mn          < 10 ? '0' : '') + int2Str(mn)
                     + (sc          < 10 ? '0' : '') + int2Str(sc);
  return strFmt("RUN-%1-%2", _planId, ts);
}
        ]]></Source>
      </Method>
      <Method>
        <Name>initValue</Name>
        <Source><![CDATA[
public void initValue()
{
    super();

    // RunId is set by the engine after PlanId is known.
    this.AssessmentDate = DateTimeUtil::getToday(DateTimeUtil::getUserPreferredTimeZone());
    this.AssessmentTime = DateTimeUtil::utcNow();
    this.Status         = ABSMRPAssessmentStatus::InProgress;
}
        ]]></Source>
