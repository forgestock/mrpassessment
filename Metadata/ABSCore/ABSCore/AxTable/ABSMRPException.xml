    <Methods>
      <Method>
        <Name>find</Name>
        <Source><![CDATA[
public static ABSMRPException find(RefRecId _recId, boolean _forUpdate = false)
{
    ABSMRPException ret;

    ret.selectForUpdate(_forUpdate);

    select firstonly ret
        where ret.RecId == _recId;

    return ret;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>exist</Name>
        <Source><![CDATA[
public static boolean exist(RefRecId _recId)
{
    return (select firstonly RecId from ABSMRPException
                where ABSMRPException.RecId == _recId).RecId != 0;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>findByPlanItemSite</Name>
        <Source><![CDATA[
public static ABSMRPException findByPlanItemSite(
    ReqPlanId           _planId,
    ItemId              _itemId,
    InventSiteId        _siteId,
    ABSMRPExceptionType _exceptionType,
    RefRecId            _reqPORecId,
    boolean             _forUpdate = false)
{
    ABSMRPException ret;

    ret.selectForUpdate(_forUpdate);

    select firstonly ret
        where ret.PlanId        == _planId
           && ret.ItemId        == _itemId
           && ret.SiteId        == _siteId
           && ret.ExceptionType == _exceptionType
           && ret.ReqPORecId    == _reqPORecId;

    return ret;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>updateStatus</Name>
        <Source><![CDATA[
public void updateStatus(ABSMRPExceptionStatus _status)
{
    ABSMRPException buffer;

    if (!this.RecId)
    {
        return;
    }

    ttsBegin;
    select forUpdate buffer
        where buffer.RecId == this.RecId;

    if (!buffer.RecId)
    {
        ttsCommit;
        return;
    }

    buffer.Status = _status;

    if (_status == ABSMRPExceptionStatus::Dismissed || _status == ABSMRPExceptionStatus::Confirmed)
    {
        buffer.ResolvedBy   = curUserId();
        buffer.ResolvedDate = DateTimeUtil::getToday(DateTimeUtil::getUserPreferredTimeZone());
    }

    buffer.update();
    ttsCommit;

    this.data(buffer);
}
        ]]></Source>
      </Method>
      <Method>
        <Name>isHighPriority</Name>
        <Source><![CDATA[
public boolean isHighPriority()
{
    return this.Severity == ABSMRPExceptionSeverity::High
        || this.ABCClass == ABSABCClassification::A;
}
        ]]></Source>
      </Method>
      <Method>
        <Name>initValue</Name>
        <Source><![CDATA[
public void initValue()
{
    super();

    this.Status      = ABSMRPExceptionStatus::Open;
    this.CreatedDate = DateTimeUtil::getToday(DateTimeUtil::getUserPreferredTimeZone());
}
        ]]></Source>
      </Method>
    </Methods>
